# ─── SkillForge API — Environment Variable Template ────────────
# Copy this file to .env and fill in your own values.
# .env is gitignored and will NOT be committed.
# ───────────────────────────────────────────────────────────────

# Server port
PORT=3000

# JWT secret — MUST be a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-here

# MongoDB connection string (from MongoDB Atlas or local mongod)
# Atlas format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillforge?retryWrites=true&w=majority
# Local format: mongodb://localhost:27017/skillforge
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillforge?retryWrites=true&w=majority

# Comma-separated allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
